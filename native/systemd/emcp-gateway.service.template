[Unit]
Description=eMCP Gateway (MCPJungle, native)
Documentation=https://github.com/mcpjungle/MCPJungle
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=__EMCP_USER__
Group=__EMCP_USER__
EnvironmentFile=__EMCP_ETC__/env
WorkingDirectory=__EMCP_DATA_DIR__
Environment=HOME=__EMCP_DATA_DIR__
__EMCP_PATH_LINE__
ExecStart=__EMCP_PREFIX__/bin/mcpjungle start --port ${EMCP_GATEWAY_PORT}
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Sandboxing — keep the gateway from writing outside its data dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__EMCP_DATA_DIR__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
