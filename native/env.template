# eMCP Native — environment file
# Generated by install.sh. Edit values then `systemctl restart emcp-gateway emcp-manager`.

# === Ports ===
# Public end-user defaults — override only if conflicting with other services.
EMCP_GATEWAY_PORT=3700
EMCP_MANAGER_PORT=3701

# === Manager → Gateway link ===
# The manager talks to the gateway over plain HTTP on loopback.
GATEWAY_URL=http://127.0.0.1:3700

# === Filesystem paths ===
# Where groups/, configs/, and the embedded SQLite live.
DATA_DIR=__EMCP_DATA_DIR__

# Path to the mcpjungle binary (installed by install.sh).
MCPJUNGLE_BIN=__EMCP_PREFIX__/bin/mcpjungle

# === Timeouts ===
# How long mcpjungle waits for an MCP server to complete its init handshake.
# Bump if you register stdio servers that fetch their package on first run.
MCP_SERVER_INIT_REQ_TIMEOUT_SEC=120

# === Optional ===
# Idle timeout (seconds) for stateful MCP sessions. -1 = never expire.
# SESSION_IDLE_TIMEOUT_SEC=-1
